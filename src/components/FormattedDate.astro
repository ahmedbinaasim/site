---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'time'> {
	date: Date;
}

const { date, ...attrs } = Astro.props;
---

<time datetime={date.toISOString().slice(0, 10)} {...attrs}>
	{date.toLocaleDateString('en-GB', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
		timeZone: 'UTC',
	})}
</time>
