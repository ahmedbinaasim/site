---
// Long-form text on ruled paper. Spacing is kept to multiples of the 2rem rule
// height so the lines of text sit on the lines of the page.
---

<div
	class="prose max-w-none text-[1.1875rem] leading-8 [--tw-prose-body:var(--color-ink)] [--tw-prose-bold:var(--color-ink)] [--tw-prose-bullets:var(--color-muted)] [--tw-prose-code:var(--color-ink)] [--tw-prose-counters:var(--color-muted)] [--tw-prose-headings:var(--color-ink)] [--tw-prose-hr:var(--color-rule)] [--tw-prose-links:var(--color-link)] [--tw-prose-quote-borders:var(--color-margin)] [--tw-prose-quotes:var(--color-ink)] prose-headings:font-serif prose-headings:font-medium prose-h2:mt-0 prose-h2:mb-0 prose-h2:text-2xl prose-h2:italic prose-h2:leading-8 prose-h3:mt-0 prose-h3:mb-0 prose-h3:text-xl prose-h3:leading-8 prose-p:my-8 prose-p:text-[1em] prose-p:leading-8 prose-ul:my-8 prose-ol:my-8 prose-li:my-0 prose-li:leading-8 prose-a:font-normal prose-a:no-underline prose-a:hand-underline prose-strong:font-semibold [&_h2+p]:mt-0 [&_h2+ul]:mt-0 [&_h3+p]:mt-0"
>
	<slot />
</div>
