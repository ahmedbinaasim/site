---
import type { CollectionEntry } from 'astro:content';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import { SITE_TITLE } from '../consts';
import Base from './Base.astro';

type Data = CollectionEntry<'blog'>['data'];
type Props = Pick<Data, 'title' | 'description'> & Partial<Pick<Data, 'pubDate' | 'updatedDate'>>;

const { title, description, pubDate, updatedDate } = Astro.props;
---

<Base title={`${title} | ${SITE_TITLE}`} description={description}>
	<article>
		<PageHeader title={title} date={pubDate} updated={updatedDate} />
		<Prose>
			<slot />
		</Prose>
	</article>
</Base>
