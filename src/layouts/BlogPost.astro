---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Data = CollectionEntry<'blog'>['data'];
type Props = Pick<Data, 'title' | 'description'> & Partial<Pick<Data, 'pubDate' | 'updatedDate'>>;

const { title, description, pubDate, updatedDate } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header>
					{pubDate && <p><FormattedDate date={pubDate} /></p>}
					<h1>{title}</h1>
					{updatedDate && <p>Updated <FormattedDate date={updatedDate} /></p>}
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
