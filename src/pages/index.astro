---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';

const latest = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Ahmed Bin Asim - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{SITE_TAGLINE}</h1>
			<p>
				I'm Ahmed Bin Asim. This is a public diary of the work: what I'm building, what breaks,
				and what I learn about securing AI agents.
			</p>

			<section aria-labelledby="now">
				<h2 id="now">What I'm doing now</h2>
				<p>
					I'm about to start <strong>mcp-audit</strong>, an open-source static analyzer for MCP
					servers. It will check for tool-description injection, over-broad permissions, missing
					authentication and unsafe command execution. Work starts on November 9, 2026 and the
					first release is targeted for December 27, 2026. It is not released yet.
				</p>
				<p>A build log goes out every Friday.</p>
			</section>

			<section aria-labelledby="latest">
				<h2 id="latest">Latest entries</h2>
				<ul>
					{latest.map((post) => (
						<li>
							<FormattedDate date={post.data.pubDate} />
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<span>{post.data.description}</span>
						</li>
					))}
				</ul>
				<p><a href="/blog/start-here/">Start here</a> if you're new.</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
